# ==============================================================
# FOMC Research Agent — Environment Configuration
# Copy this file as .env and fill in your values.
# ==============================================================

# ---- DEPLOYMENT MODE ----
# Choose how to run the agent:
#   standalone  = CLI or adk web (local development)
#   cloudrun    = FastAPI server on Cloud Run
#   vps         = Docker/docker-compose on a VPS
#   railway     = Railway PaaS
#   render      = Render PaaS
#   vertex      = Vertex AI Agent Engine (original method)
DEPLOYMENT_MODE=standalone

# ---- MODEL BACKEND ----
# 0 = ML Dev / API Key (simpler, works anywhere)
# 1 = Vertex AI (requires GCP project + credentials)
GOOGLE_GENAI_USE_VERTEXAI=0

# ---- API KEY MODE (GOOGLE_GENAI_USE_VERTEXAI=0) ----
# Get your key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=YOUR_API_KEY_HERE

# ---- VERTEX AI MODE (GOOGLE_GENAI_USE_VERTEXAI=1) ----
# Required when using Vertex AI backend
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
GOOGLE_CLOUD_PROJECT_NUMBER=YOUR_PROJECT_NUMBER
GOOGLE_CLOUD_LOCATION=us-central1

# ---- BIGQUERY (Required for rate probability computation) ----
# The agent uses BigQuery to store and query Fed Futures pricing data.
# This is required regardless of deployment platform.
GOOGLE_CLOUD_BQ_DATASET=fomc_data

# ---- CLOUD STORAGE (Vertex AI Agent Engine only) ----
# Only needed for original Agent Engine deployment (deploy.py)
# GOOGLE_CLOUD_STORAGE_BUCKET=YOUR_BUCKET_NAME

# ---- MODEL ----
# Choose a Gemini model (default: gemini-2.5-flash)
GOOGLE_GENAI_MODEL=gemini-2.5-flash

# ---- AGENT CONFIGURATION ----
# Timeseries codes for Fed Futures data in BigQuery
# Default codes cover the sample dataset (Jan/Mar 2025 FOMC meetings)
GOOGLE_GENAI_FOMC_AGENT_TIMESERIES_CODES="SFRH5,SFRZ5"

# Log level: DEBUG, INFO, WARNING, ERROR
GOOGLE_GENAI_FOMC_AGENT_LOG_LEVEL=INFO

# ---- HTTP SERVER (Cloud Run / Railway / Render / VPS) ----
# Port for the FastAPI server (default: 8080)
PORT=8080
